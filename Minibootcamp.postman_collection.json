  "item": [
    {
      "name": "Post Bank account data request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Test Response Body\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.bank_account_number).to.not.be.undefined;",
              "    pm.expect(jsonData.bank_account_number.toString().length).to.be.at.least(6);",
              "    pm.expect(jsonData.bank_code).to.eql(\"BCA\");",
              "    pm.expect(jsonData.status).to.eql(\"COMPLETED\");",
              "    pm.expect(jsonData.reference_id).not.null;",
              "});",
              "",
              "let jsonData = pm.response.json();",
              "pm.environment.set(\"id\", jsonData.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Basic aWx1bWFfZGV2ZWxvcG1lbnRfRlg0ZjBNNXN4RGdrNXFGeVpuazYwWmVuZ0FmQTlvMzF4M2VjZDI5dmloamM0Vmh5SjhGY2xaaEhqanc6"
          }
