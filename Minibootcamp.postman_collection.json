          "raw": "{\n    \"bank_account_number\": \"12345678\",\n    \"bank_code\": \"BCA\",\n    \"given_name\": \"FIRA DIYANKA\",\n    \"surname\": \"FIRA DIYANKA\",\n    \"reference_id\": \"abc\"\n}",
          "options": {
