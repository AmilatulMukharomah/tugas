              "    pm.expect(jsonData.bank_account_number).to.not.be.undefined;\r",
              "    pm.expect(jsonData.bank_account_number.toString().length).to.be.at.least(6);\r",
              "    pm.expect(jsonData.bank_code).to.eql(\"BCA\");\r",
              "    pm.expect(jsonData.status).to.eql(\"COMPLETED\");\r",
              "    pm.expect(jsonData.reference_id).not.null;\r",
              "});\r",
              "\r",
              "let jsonData = pm.response.json();\r",
